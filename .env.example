# =============================================================================
# SplitMate — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local            (macOS / Linux)
#     Copy-Item .env.example .env.local     (Windows PowerShell)
#
# `.env.local` is git-ignored and must never be committed.
# Every variable below is validated at startup by lib/env.ts, so a missing or
# malformed value fails immediately with a message naming the variable.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — public values (safe in the browser)
# -----------------------------------------------------------------------------
# Find these in your Supabase dashboard under Project Settings → API.
# For local development with the Supabase CLI, `npx supabase start` prints them.

# Project endpoint. Local default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# The anon (publishable) key.
#
# This key IS exposed to the browser, and that is by design. It identifies the
# project but carries no privileges of its own: every query it makes is still
# evaluated against Row Level Security, so a user can only ever read or write
# rows their policies allow. Its safety depends entirely on RLS being enabled
# on every table — which is why our migrations enable it everywhere with no
# permissive fallback.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Canonical origin, used to build magic-link redirects and invitation URLs.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server-only secrets — NEVER prefix these with NEXT_PUBLIC_
# -----------------------------------------------------------------------------

# Service-role key: BYPASSES Row Level Security completely.
#
# Used by exactly one code path — the scheduled recurring-expense job — because
# that job acts as the system rather than as a signed-in user. Anything else
# that needs data uses the caller's own JWT. If this key leaks, every household's
# finances are readable and writable by whoever holds it.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that proves an inbound /api/cron/* request really came from
# Vercel Cron. Compared in constant time. Generate a strong random value:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# -----------------------------------------------------------------------------
# Email (optional in development)
# -----------------------------------------------------------------------------
# Without these, invitation emails are skipped and the invite link is logged to
# the server console instead — enough to develop the whole flow locally.
RESEND_API_KEY=
EMAIL_FROM="SplitMate <invites@yourdomain.com>"
