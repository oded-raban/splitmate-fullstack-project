{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,

    /* ---------------------------------------------------------------------
     * Strictness
     * ---------------------------------------------------------------------
     * This is a financial application: an `undefined` that slips through the
     * type system becomes a wrong number on someone's balance. The flags below
     * are deliberately stricter than the Next.js default template.
     *
     * `strict` turns on the core family (noImplicitAny, strictNullChecks,
     * strictFunctionTypes, useUnknownInCatchVariables, ...). The extra flags
     * close the gaps `strict` leaves open.
     * ------------------------------------------------------------------- */
    "strict": true,

    /* Indexing an array returns `T | undefined` rather than `T`. Without this,
     * `weights[i]` is typed `number` even when `i` is out of bounds, which is
     * exactly the class of bug that silently produces a wrong split. */
    "noUncheckedIndexedAccess": true,

    /* A `case` that falls through to the next one is almost always a mistake;
     * our split-method and error-code switches must be exhaustive. */
    "noFallthroughCasesInSwitch": true,

    /* Overriding a base member must be explicit. */
    "noImplicitOverride": true,

    /* `obj["key"]` is required for index-signature access, so a typo in a
     * property name cannot silently read `undefined`. */
    "noPropertyAccessFromIndexSignature": true,

    /* Windows is case-insensitive but Vercel's Linux builders are not.
     * This makes a casing mismatch fail locally instead of only in CI. */
    "forceConsistentCasingInFileNames": true,

    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", ".next", "playwright-report", "test-results"]
}
